<UserControl x:Class="HSLCopy.Usc.SerialControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HSLCopy.Usc"
             mc:Ignorable="d" 
             >
    <Grid>
        <StackPanel Orientation="Horizontal">
            <TextBlock Margin="10,0,5,0" Text="Com口:" FontSize="13" VerticalAlignment="Center"/>
            <Menu Height="25" FontSize="11" Width="100">
                <MenuItem   Header="Com19" >
                    <!--Padding 内部内容与控件边框之间的间距-->
                    <MenuItem Header="COM19"  Padding="-15,0,0,0" Width="60"/>
                    <MenuItem Header="Tcp/Ip"  Padding="-15,0,0,0" Width="60"/>
                </MenuItem>
            </Menu>
            <TextBlock Margin="10,0,5,0" Text="波特率:" FontSize="13" VerticalAlignment="Center"/>
            <TextBox Text="5050" Margin="5,0,5,0" Height="25" Width="60" Style="{StaticResource MaterialDesignTextBoxBase}" Background="White" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock Margin="10,0,5,0" Text="数据位:" FontSize="13" VerticalAlignment="Center"/>
            <TextBox Text="{Binding IP}" Margin="5,0,5,0" Height="25" Width="40" Style="{StaticResource MaterialDesignTextBoxBase}" Background="White" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock Margin="10,0,5,0" Text="停止位:" FontSize="13" VerticalAlignment="Center"/>
            <TextBox Text="{Binding IP}" Margin="5,0,5,0" Height="25" Width="40" Style="{StaticResource MaterialDesignTextBoxBase}" Background="White" FontSize="13" VerticalAlignment="Center" TextChanged="TextBox_TextChanged"/>
            <TextBlock Margin="10,0,5,0" Text="奇偶:" FontSize="13" VerticalAlignment="Center"/>
            <Menu Margin="10,0,5,0" Height="25" FontSize="11">
                <MenuItem   Header="Tcp/Ip" >
                    <!--Padding 内部内容与控件边框之间的间距-->
                    <MenuItem Header="Tcp/Ip"  Padding="-15,0,0,0" Width="60"/>
                    <MenuItem Header="Tcp/Ip"  Padding="-15,0,0,0" Width="60"/>
                </MenuItem>
            </Menu>
            <Button Margin="5,0,5,0" Content="more"/>
        </StackPanel>
    </Grid>
</UserControl>
