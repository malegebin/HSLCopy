<Window x:Class="HSLCopy.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HSLCopy.Views"
        mc:Ignorable="d"
        Title="MainWindow"
        xmlns:vm="clr-namespace:HSLUILearnDome.ViewModels" 
        d:DataContext="{d:DesignInstance vm:MainViewModel}" 
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Height="750" Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="0.7*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderThickness="1" BorderBrush="CornflowerBlue" Background="#506483">
            <StackPanel Orientation="Horizontal">
                <Menu Style="{x:Null}" Margin="15,2,15,0" Background="Transparent">
                    <MenuItem Header="语言" Foreground="White" FontSize="13">
                        <MenuItem Header="English" Foreground="Black" />
                        <MenuItem Header="中文" Foreground="Black" />
                    </MenuItem>
                </Menu>
                <Menu Style="{x:Null}" Margin="15,2,15,0" Background="Transparent">
                    <MenuItem Header="调试" Foreground="White" FontSize="13">
                        <MenuItem Header="English" Foreground="Black" />
                        <MenuItem Header="中文" Foreground="Black" />
                    </MenuItem>
                </Menu>
                <Menu Style="{x:Null}" Margin="15,2,15,0" Background="Transparent">
                    <MenuItem Header="帮助" Foreground="White" FontSize="13">
                        <MenuItem Header="English" Foreground="Black" />
                        <MenuItem Header="中文" Foreground="Black" />
                    </MenuItem>
                </Menu>
                <Menu Style="{x:Null}" Margin="15,2,15,0" Background="Transparent">
                    <MenuItem Header="Version" Foreground="White" FontSize="13">
                        <MenuItem Header="English" Foreground="Black" />
                        <MenuItem Header="中文" Foreground="Black" />
                    </MenuItem>
                </Menu>
                <Menu Style="{x:Null}" Margin="15,2,15,0" Background="Transparent">
                    <MenuItem Header="Active" Foreground="White" FontSize="13">
                        <MenuItem Header="English" Foreground="Black" />
                        <MenuItem Header="中文" Foreground="Black" />
                    </MenuItem>
                </Menu>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.13*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Border Margin="1" BorderThickness="1" BorderBrush="CornflowerBlue" Background="#506483">
                    <TextBlock Text="设备列表" FontSize="14" Foreground="White"/>
                </Border>
                <TreeView Style="{x:Null}" Name="DeviceTreeViewEvent" >
                    <TreeViewItem Style="{x:Null}" Margin="0,2,0,2" Header="Siemens Plc[西门子]" IsSelected="True">
                        <TreeViewItem Style="{x:Null}" Tag="S71200View"  Header="S7-S1200}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Selected">
                                    <i:InvokeCommandAction Command=
                                    "{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Window},Path=DataContext.NavigationCommand}" 
                                     CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TreeViewItem}, Path=Tag}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TreeViewItem>
                        <TreeViewItem Style="{x:Null}"  Header="S7-S1500">
                        </TreeViewItem>
                    </TreeViewItem>

                    <TreeViewItem Style="{x:Null}" Margin="0,2,0,2" Header="ModBus" IsSelected="True">
                        <TreeViewItem Style="{x:Null}"  Header="Modbus Rtu">
                        </TreeViewItem>
                        <TreeViewItem Style="{x:Null}"  Header="ModBus Tcp">
                        </TreeViewItem>
                    </TreeViewItem>
                </TreeView>

            </StackPanel>


            <Border Grid.Column="1" BorderThickness="1" BorderBrush="CornflowerBlue" Background="AliceBlue">
                <ContentControl x:Name="Page" HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"/>
            </Border>
        </Grid>
    </Grid>

</Window>
