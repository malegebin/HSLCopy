<UserControl x:Class="HSLCopy.Views.CommandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HSLCopy.Views"
             mc:Ignorable="d"     
             xmlns:vm="clr-namespace:HSLCopy.ViewModels" 
             d:DataContext="{d:DesignInstance vm:CommandViewModel}"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,0,7,12" VerticalAlignment="Center">
            <TextBox x:Name="FindCommandTextBox"
                     MinWidth="150" Height="25" Margin="0,0,5,0"
                     VerticalContentAlignment="Center"
                     hc:InfoElement.Placeholder="搜索指令..." />
        </StackPanel>

        <TreeView Grid.Row="1"
                  x:Name="InitCommandTreeView"
                  ItemsSource="{Binding Nodes}"
                  MouseDoubleClick="AddToStepsRunning_MouseDoubleClick">

            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <!-- ★ 加上 ToolTip 绑定，让类的全名和方法注释能显示出来 ★ -->
                    <TextBlock Text="{Binding HeaderName}" 
                               ToolTip="{Binding ToolTip}" 
                               Margin="2" />
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>

            <TreeView.ContextMenu>
                <ContextMenu>
                    <!-- ★ 修正命令名称为 ReloadAsyncCommand ★ -->
                    <MenuItem Header="重新加载"
                      Command="{Binding PlacementTarget.DataContext.ReloadAsyncCommand, 
                              RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </TreeView.ContextMenu>
        </TreeView>
    </Grid>
</UserControl>