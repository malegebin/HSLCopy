<UserControl x:Class="HSLCopy.Views.ToolBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HSLCopy.Views"
             mc:Ignorable="d"     
             xmlns:vm="clr-namespace:HSLCopy.ViewModels" 
             d:DataContext="{d:DesignInstance vm:ToolBarViewModel}"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DesignWidth="900"
             Height="60">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- 图标+文字按钮样式 -->
        <Style x:Key="IdeToolBarButton" TargetType="Button">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="4,3">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- 图标：直接用 ContentPresenter 显示 Button.Content -->
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,0,2"/>
                                <!-- 文字：从 Tag 属性读取 -->
                                <TextBlock Text="{TemplateBinding Tag}" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0"/>
                                <Setter Property="Foreground" Value="#111111"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C8C8C8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#BBBBBB"/>
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 运行控制区大按钮 -->
        <Style x:Key="RunControlButton" TargetType="Button" BasedOn="{StaticResource IdeToolBarButton}">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="50"/>
        </Style>

        <!-- 分隔线样式 -->
        <Style x:Key="ToolBarSeparator" TargetType="Separator">
            <Setter Property="Margin" Value="4,6"/>
            <Setter Property="Background" Value="#C0C0C0"/>
        </Style>

        <!-- 分组边框 -->
        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">

        <DockPanel VerticalAlignment="Center" Margin="6,0">

            <!-- 左侧：导航 + 文件操作 -->
            <Border Style="{StaticResource GroupBorder}" DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal">

                    <Button Style="{StaticResource IdeToolBarButton}" 
                            Command="{Binding NavigateBackCommand}"
                            ToolTip="返回上级程序"
                            Tag="返回">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20"/>
                    </Button>

                    <Separator Style="{StaticResource ToolBarSeparator}"/>

                    <Button Style="{StaticResource IdeToolBarButton}" 
                            Command="{Binding FileNewCommand}"
                            ToolTip="新建"
                            Tag="新建">
                        <materialDesign:PackIcon Kind="FileDocumentOutline" Width="20" Height="20"/>
                    </Button>

                    <Button Style="{StaticResource IdeToolBarButton}" 
                            Command="{Binding FileOpenCommand}"
                            ToolTip="打开"
                            Tag="打开">
                        <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20"/>
                    </Button>

                    <Button Style="{StaticResource IdeToolBarButton}" 
                            Command="{Binding FileSaveCommand}"
                            ToolTip="保存"
                            Tag="保存">
                        <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20"/>
                    </Button>

                    <Button Style="{StaticResource IdeToolBarButton}" 
                            Command="{Binding FileSaveAsOtherCommand}"
                            ToolTip="另存为"
                            Tag="另存为">
                        <materialDesign:PackIcon Kind="ContentSaveAll" Width="20" Height="20"/>
                    </Button>

                    <Button Style="{StaticResource IdeToolBarButton}" 
                            Command="{Binding SetDefaultProgramCommand}"
                            ToolTip="设置默认程序"
                            Tag="默认程序">
                        <materialDesign:PackIcon Kind="FileStarOutline" Width="20" Height="20"/>
                    </Button>

                </StackPanel>
            </Border>

            <!-- 配置区 -->
            <Border Style="{StaticResource GroupBorder}" DockPanel.Dock="Left" Margin="4,2,0,2">
                <StackPanel Orientation="Horizontal">

                    <Button Style="{StaticResource IdeToolBarButton}" 
                            Command="{Binding SystemConfigCommand}"
                            IsEnabled="{Binding IsAdmin}"
                            ToolTip="系统设置"
                            Tag="系统设置">
                        <materialDesign:PackIcon Kind="Cog" Width="20" Height="20"/>
                    </Button>

                    <Button Style="{StaticResource IdeToolBarButton}" 
                            Command="{Binding DeviceManageCommand}"
                            IsEnabled="{Binding IsAdmin}"
                            ToolTip="设备管理"
                            Tag="设备管理">
                        <materialDesign:PackIcon Kind="Devices" Width="20" Height="20"/>
                    </Button>

                </StackPanel>
            </Border>

            <!-- 右侧：报告 + 运行控制 -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">

                <!-- 报告区 -->
                <Border Style="{StaticResource GroupBorder}" Margin="0,2,4,2">
                    <Button Style="{StaticResource IdeToolBarButton}" 
                            Command="{Binding ExportReportCommand}"
                            IsEnabled="{Binding CanExportReport}"
                            ToolTip="导出报告"
                            Tag="导出报告">
                        <materialDesign:PackIcon Kind="BookOutline" Width="20" Height="20"/>
                    </Button>
                </Border>

                <!-- 核心运行控制区 -->
                <Border Background="#E2E2E2" 
                        CornerRadius="5" 
                        Padding="4,2"
                        Margin="0,2,0,2">
                    <StackPanel Orientation="Horizontal">

                        <!-- 运行/停止切换 -->
                        <Button Style="{StaticResource RunControlButton}" 
                                Command="{Binding ProgramRunCommand}"
                                IsEnabled="{Binding CanRun}"
                                ToolTip="{Binding RunState}"
                                Tag="{Binding RunState}">
                            <Grid>
                                <materialDesign:PackIcon Kind="Play" 
                                                        Width="22" Height="22" 
                                                        Foreground="#2E7D32"
                                                        Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisConverter}}"/>
                                <materialDesign:PackIcon Kind="Stop" 
                                                        Width="22" Height="22" 
                                                        Foreground="#F57F17"
                                                        Visibility="{Binding IsStopped, Converter={StaticResource BoolToVisConverter}}"/>
                            </Grid>
                        </Button>

                        <!-- 单步执行 -->
                        <Button Style="{StaticResource RunControlButton}" 
                                Command="{Binding SingleStepExecutionCommand}"
                                IsEnabled="{Binding CanRun}"
                                ToolTip="单步执行"
                                Tag="单步">
                            <materialDesign:PackIcon Kind="DebugStepOver" Width="20" Height="20"/>
                        </Button>

                        <Separator Style="{StaticResource ToolBarSeparator}" Margin="3,6"/>

                        <!-- 强制停止 -->
                        <Button Style="{StaticResource RunControlButton}" 
                                Command="{Binding TerminateCommand}"
                                IsEnabled="{Binding CanStop}"
                                ToolTip="强制停止"
                                Tag="强制停止">
                            <materialDesign:PackIcon Kind="Stop" Width="20" Height="20" Foreground="#C62828"/>
                        </Button>

                        <!-- 复位 -->
                        <Button Style="{StaticResource RunControlButton}" 
                                Command="{Binding ResetCommand}"
                                IsEnabled="{Binding CanReset}"
                                ToolTip="复位"
                                Tag="复位">
                            <materialDesign:PackIcon Kind="Restart" Width="20" Height="20"/>
                        </Button>

                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- 中间空白 -->
            <Grid Background="Transparent"/>

        </DockPanel>
    </Grid>
</UserControl>